# TheraDOS Environment Variables

# App Environment
ENVIRONMENT=development
SECRET_KEY=dev_jwt_secret_key_change_in_production_32bytes

# Database Config
DATABASE_URL=postgresql+asyncpg://therados:therados_dev_password@localhost:5432/therados_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=therados_dev_password

# Redis & Temporal
REDIS_URL=redis://localhost:6379/0
TEMPORAL_HOST=localhost:7233

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=therados_minio
S3_SECRET_KEY=therados_dev_password
S3_BUCKET_NAME=therados-files

# Model Fabric & LLM Providers (Optional / Replaceable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Chemical / Computational Providers (Optional)
AUTODOCK_VINA_PATH=
